# Настройки для запуска на своём компьютере (npm run local).
# Скопируйте этот файл в .env и впишите значения. Файл .env в git не попадает.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш chat id: напишите боту /myid
ADMIN_CHAT_ID=

# Куда ведёт кнопка «Написать напрямую»
CONTACT_USERNAME=pplakhin

# Необязательно. Без них ответы хранятся в памяти до перезапуска.
# Значения можно взять в Vercel: Settings → Environment Variables.
KV_REST_API_URL=
KV_REST_API_TOKEN=
